{
  "name": "webedge-hosting-portal",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight hosting management portal (Node.js + PostgreSQL + Prisma) with pluggable hosting-provider integrations. Hostinger supported first.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node --watch src/server.js",
    "start": "node scripts/start.js",
    "seed": "node prisma/seed.js",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "test": "node --test tests/*.test.js",
    "start:server": "node src/server.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "basic-ftp": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "imapflow": "^2.0.5",
    "mailparser": "^3.9.28",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "prisma": "^6.1.0",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "ftp-srv": "^4.6.3",
    "hoodiecrow-imap": "^2.1.0",
    "smtp-server": "^3.19.13"
  }
}
