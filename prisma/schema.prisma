// Hosting Management Portal — database schema
// Kept deliberately small: one table per real concept, no speculative columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  USER
}

/// Where a record originally came from. Domains synced from a provider keep the
/// provider label; anything an admin types in by hand is MANUAL.
enum DomainSource {
  PROVIDER
  MANUAL
}

// ---------------------------------------------------------------------------
// Users & access
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Two-factor authentication. The shared secret is encrypted at rest the
  /// same way provider tokens are: a database dump on its own must not be
  /// enough to generate valid codes.
  totpSecret    String?
  /// Null means enrolment was never completed. A secret without this is a
  /// half-finished setup and must not be accepted at sign-in.
  totpEnabledAt DateTime?
  /// The last 30-second step a code was accepted for. A valid code is valid
  /// for its whole window, so without this the same six digits could be
  /// replayed by anyone who saw them.
  totpLastStep  BigInt?

  domains         UserDomain[]
  serverResource  ServerResource?
  queryLog        DatabaseQueryLog[]
  ordersPlaced    Order[]            @relation("OrderCustomer")
  ordersConfirmed Order[]            @relation("OrderConfirmedBy")
  activityLogs    ActivityLog[]
  recoveryCodes   RecoveryCode[]
  tickets         Ticket[]
  ticketMessages  TicketMessage[]
  billingDocs     BillingDocument[]

  @@map("users")
}

/// Join table: which domains a normal user is allowed to see and manage.
model UserDomain {
  id         String   @id @default(cuid())
  userId     String
  domainId   String
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, domainId])
  @@index([domainId])
  @@map("user_domains")
}

// ---------------------------------------------------------------------------
// Hosting providers
// ---------------------------------------------------------------------------

/// A configured hosting provider. `adapter` selects the server-side integration
/// (e.g. "hostinger"); adding a provider later means adding an adapter file.
model Provider {
  id        String   @id @default(cuid())
  name      String
  adapter   String
  docsUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Result of the most recent "Test Connection" click.
  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  lastSyncedAt    DateTime?

  credential ProviderCredential?
  domains    Domain[]

  @@map("providers")
}

/// API token for a provider, encrypted at rest (AES-256-GCM) and never sent to
/// the browser — only `tokenHint` (last 4 characters) is ever exposed.
model ProviderCredential {
  id             String   @id @default(cuid())
  providerId     String   @unique
  encryptedToken String
  tokenHint      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_credentials")
}

// ---------------------------------------------------------------------------
// Domains
// ---------------------------------------------------------------------------

model Domain {
  id     String       @id @default(cuid())
  name   String       @unique
  source DomainSource @default(PROVIDER)

  // Null for manually added domains.
  providerId String?
  /// Provider's own identifier, used to match records on re-sync.
  externalId String?

  status       String    @default("unknown")
  type         String?
  expiresAt    DateTime?
  registeredAt DateTime?
  lastSyncedAt DateTime?

  /// What the site was last detected to be built on, and the evidence for it.
  /// Refreshed on every detection and never hand-edited, the same way mailbox
  /// figures are, so the real answer survives an administrator choosing to
  /// display something else.
  detectedTech         String?
  detectedTechVersion  String?
  /// "files" (read off the site's own filesystem) or "site" (read off the
  /// homepage). Which one it was changes how much the answer is worth.
  detectedTechSource   String?
  /// Why the detector concluded this, in words, e.g. "found wp-config.php".
  detectedTechEvidence String?
  /// "confirmed" or "likely".
  detectedTechLevel    String?
  detectedTechAt       DateTime?

  /// Administrator override. Null means "use what was detected", which is why
  /// it is nullable rather than defaulted — absent is meaningful here.
  techOverride        String?
  techVersionOverride String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider      Provider?          @relation(fields: [providerId], references: [id], onDelete: SetNull)
  dnsRecords    DnsRecord[]
  emailAccounts EmailAccount[]
  queryLog      DatabaseQueryLog[]
  orders        Order[]
  activity      ActivityLog[]
  settings      DomainSettings?
  assignments   UserDomain[]
  reminders     ExpiryReminder[]
  tickets       Ticket[]
  billingDocs   BillingDocument[]
  deployments   Deployment[]

  @@index([providerId])
  @@map("domains")
}

model DnsRecord {
  id       String @id @default(cuid())
  domainId String

  name    String
  type    String
  content String
  ttl     Int    @default(3600)

  /// True when the record came from the provider's DNS zone rather than being
  /// entered by hand. Provider records are replaced wholesale on each sync.
  isFromProvider Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@map("dns_records")
}

model EmailAccount {
  id       String @id @default(cuid())
  domainId String

  address String
  status  String  @default("unknown")
  notes   String?

  /// What the provider last reported. Refreshed on every sync and never
  /// hand-edited, so the real numbers are always available even when an
  /// administrator is choosing to display something else.
  providerQuotaMb Int?
  providerUsedMb  Int?

  /// Administrator overrides. Null means "use the provider's value", which is
  /// why these are nullable rather than defaulted — absent is meaningful here.
  quotaMbOverride Int?
  usedMbOverride  Int?

  /// Distinguishes mailboxes fetched from the provider from ones typed in.
  isFromProvider Boolean @default(false)
  externalId     String?

  /// The mailbox's own password, encrypted at rest (AES-256-GCM). Used to sign
  /// in to IMAP and SMTP on the owner's behalf; never sent to the browser.
  encryptedPassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, address])
  @@index([domainId])
  @@map("email_accounts")
}

/// Per-domain details the provider API does not expose (FTP/FTPS, server info,
/// notes). Everything here is optional and admin-maintained.
model DomainSettings {
  id       String @id @default(cuid())
  domainId String @unique

  // FTP / FTPS
  ftpHost     String?
  ftpPort     Int?
  ftpUsername String?
  ftpPassword String?
  ftpProtocol String? // FTP | FTPS | SFTP

  /// Directory the file manager is confined to, e.g. /public_html. Everything
  /// browsed through the portal is resolved beneath this.
  ftpRootPath String?

  // Mail servers, shared by every mailbox on the domain.
  //
  // These are what the portal connects to. They are the provider's real
  // hostnames, so they are Super Admin's to see and nobody else's.
  imapHost   String?
  imapPort   Int?
  imapSecure Boolean @default(true)
  smtpHost   String?
  smtpPort   Int?
  smtpSecure Boolean @default(true)

  /// What a customer is told to type into Outlook, which is not always the
  /// same thing. Three choices, because all three are real:
  ///
  ///   STANDARD — whatever the portal-wide setup settings say. The usual case.
  ///   REAL     — hand out the provider's own hostnames above, unchanged. For
  ///              a domain the standard hostnames cannot serve.
  ///   CUSTOM   — hostnames just for this domain, typed in below.
  ///
  /// STANDARD with nothing configured portal-wide falls back to REAL, because
  /// the one thing this must never do is hand somebody a hostname that does
  /// not answer.
  mailSetupMode String @default("STANDARD")

  /// Used only when mailSetupMode is CUSTOM.
  publicImapHost String?
  publicImapPort Int?
  publicSmtpHost String?
  publicSmtpPort Int?

  /// MySQL / MariaDB access. The provider API does not hand these out, so they
  /// are entered by hand, the same way FTP is. The password is encrypted at
  /// rest and never sent to the browser.
  dbHost     String?
  dbPort     Int?
  dbName     String?
  dbUser     String?
  dbPassword String?

  /// Whether statements that change data may run. Off means the query editor
  /// will only SELECT, which is the safe default for a database somebody's
  /// website depends on.
  dbAllowWrites Boolean @default(false)

  // Server information
  serverIp       String?
  serverHostname String?
  serverLocation String?
  nameservers    String?
  phpVersion     String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("domain_settings")
}

// ---------------------------------------------------------------------------
// Server resources (manually configured per user)
// ---------------------------------------------------------------------------

model ServerResource {
  id     String @id @default(cuid())
  userId String @unique

  cpuCores    Int?
  ramMb       Int?
  storageGb   Int?
  bandwidthGb Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("server_resources")
}

/// The express-session store, owned by connect-pg-simple at runtime.
///
/// It is declared here so the schema is the single source of truth and
/// migrations stop reporting drift; the application creates it via a
/// migration rather than at boot (see `createTableIfMissing: false`).
model UserSession {
  sid    String   @id(map: "session_pkey")
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}

/// A record of every statement that changed something, and who ran it.
///
/// A query box shared between people needs an audit trail: when a table looks
/// wrong a week later, this is the only thing that can say what went through
/// it. Reads are not logged — they are the ordinary case and would bury the
/// entries that matter.
model DatabaseQueryLog {
  id       String  @id @default(cuid())
  domainId String
  /// Null once the account that ran it has been deleted; the record of the
  /// statement outlives the person, which is rather the point.
  userId   String?

  /// Truncated to a sane length. This is a record, not a replay log.
  sql    String
  /// write | destructive | schema
  kind   String
  verb   String
  target String?

  createdAt DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([domainId, createdAt])
  @@map("database_query_log")
}

// ---------------------------------------------------------------------------
// The storefront: what is for sale, and what people have ordered.
//
// Money is stored in paise as whole integers. A price is never a float — a
// rounding error in a number somebody is asked to pay is not an acceptable
// class of bug, and 1499.99 cannot be held exactly in binary floating point.
// ---------------------------------------------------------------------------

enum PlanKind {
  HOSTING
  EMAIL
  OTHER
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

/// A hosting plan as it appears on the public site.
model Plan {
  id      String   @id @default(cuid())
  /// Used in the public URL, so it stays stable even when the name changes.
  slug    String   @unique
  name    String
  kind    PlanKind @default(HOSTING)
  tagline String?

  priceMinor    Int
  /// Shown struck through beside the price, for a plan that is discounted.
  wasPriceMinor Int?
  currency      String        @default("INR")
  billingPeriod BillingPeriod @default(YEARLY)

  /// One selling point per entry, in the order they should be read.
  features String[]

  /// Hidden plans stay orderable by reference but off the public list, so a
  /// plan can be retired without breaking the orders that already name it.
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

/// What one domain ending costs. A .com and a .in are genuinely different
/// prices, so this is a list rather than a single "domain" plan.
model TldPrice {
  id  String @id @default(cuid())
  /// Without the dot, lower case: "com", "co.in".
  tld String @unique

  registerMinor Int
  /// What it costs to keep, where that differs from the first year. Shown so
  /// nobody is surprised at renewal.
  renewMinor    Int?
  currency      String @default("INR")

  isActive  Boolean @default(true)
  isPopular Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("tld_prices")
}

enum OrderKind {
  HOSTING
  DOMAIN
}

enum OrderStatus {
  /// Placed, nothing paid yet.
  PENDING_PAYMENT
  /// The customer says they have paid and given a reference. Nobody has
  /// checked. This status exists precisely because UPI cannot confirm itself.
  PAYMENT_SUBMITTED
  /// An administrator has seen the money arrive.
  PAID
  /// Set up and handed over.
  PROVISIONED
  CANCELLED
}

model Order {
  id String @id @default(cuid())

  /// What the customer is given, and the only key the public lookup accepts.
  /// Random rather than sequential: it is effectively a bearer token, so it
  /// must not be guessable from another order's.
  reference String @unique

  kind       OrderKind
  planId     String?
  /// The ending ordered, for a domain order.
  tld        String?
  /// The domain being registered, or the one hosting is for.
  domainName String?

  customerName  String
  customerEmail String
  customerPhone String
  message       String?

  /// Worked out on the server from the plan or the TLD. What the browser
  /// thought the price was is never trusted.
  amountMinor   Int
  currency      String         @default("INR")
  billingPeriod BillingPeriod?

  status OrderStatus @default(PENDING_PAYMENT)

  /// What the customer typed after paying. Unverified by definition — a UPI
  /// reference cannot be checked from here, and anyone could invent one.
  paymentReference   String?
  paymentSubmittedAt DateTime?
  paidAt             DateTime?
  provisionedAt      DateTime?

  /// Who confirmed the payment, so a money decision has a name against it.
  confirmedById String?
  adminNotes    String?

  /// Filled in once the order has been turned into something real.
  domainId String?
  userId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingDocs BillingDocument[]
  plan        Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  confirmedBy User?             @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  domain      Domain?           @relation(fields: [domainId], references: [id], onDelete: SetNull)
  user        User?             @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("orders")
}

/// The one row of storefront configuration: who is selling, and how to pay.
model StoreSettings {
  /// A single row, addressed by a fixed id.
  id String @id @default("default")

  businessName String?
  headline     String?
  subheadline  String?
  supportEmail String?

  /// Where the money goes. Shown to customers, so it is deliberately not a
  /// secret — but it is the one field that decides who gets paid, so only a
  /// Super Admin can change it.
  upiId        String?
  upiPayeeName String?

  /// Digits with country code, no plus or spaces: 919876543210.
  whatsappNumber String?

  currency String  @default("INR")
  /// Closes the shop without deleting anything.
  isOpen   Boolean @default(true)

  // -------------------------------------------------------------------------
  // Who is issuing the invoice.
  //
  // Separate from the storefront's marketing name above: a tax document needs
  // the registered name and address, which is often not the brand name.
  // -------------------------------------------------------------------------

  legalName    String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  /// Two digits, as GST uses them: "09" is Uttar Pradesh, "27" Maharashtra.
  /// This is what decides CGST + SGST against IGST, so it is not decorative.
  stateCode    String?
  stateName    String?
  pincode      String?
  gstin        String?
  pan          String?

  /// Shown on the invoice for customers who pay by transfer rather than UPI.
  bankName    String?
  bankAccount String?
  bankIfsc    String?
  bankBranch  String?

  /// Prefixes for the document numbers, e.g. INV/2026-27/001.
  invoicePrefix   String @default("INV")
  quotationPrefix String @default("QTN")

  /// What a new line item starts at. 18% covers hosting and most services.
  defaultTaxPct       Int     @default(18)
  /// Whether new documents have GST on by default. Off is entirely legitimate:
  /// a business below the registration threshold issues a bill of supply.
  gstEnabledByDefault Boolean @default(true)

  invoiceTerms       String?
  quotationTerms     String?
  /// How long a quotation stands, in days.
  quotationValidDays Int     @default(15)

  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

// ---------------------------------------------------------------------------
// Knowing what happened.
//
// Every change worth an administrator's attention is written here first, and
// emailed second. That order matters: the record is the product, and the email
// is one way of reading it. An SMTP server that is down, misconfigured or
// simply slow must not cost you the history.
// ---------------------------------------------------------------------------

model ActivityLog {
  id String @id @default(cuid())

  /// A dotted name: "dns.record.deleted", "email.mailbox.created". Grouped by
  /// its first part so a whole area can be switched off at once.
  event String

  /// Who did it. Null for something the system did, or once the account has
  /// been deleted — the record of the act outlives the actor.
  actorId    String?
  /// Kept as text as well, so an entry still reads correctly after the account
  /// it names is gone.
  actorLabel String?
  actorRole  String?

  /// One line, already written for a person: "Deleted the MX record for @".
  summary String
  /// Anything worth having in the email but not in the headline.
  detail  String?

  /// What it happened to, where that makes sense.
  domainId   String?
  domainName String?

  /// Where the request came from, for the sign-in failures.
  ip String?

  /// Whether an email went out, and why not when it did not. Without this,
  /// "I never got an alert" is unanswerable.
  notified    Boolean @default(false)
  notifyError String?

  createdAt DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  domain Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([event, createdAt])
  @@map("activity_log")
}

/// Application settings: one row, for things that are not about a domain.
model AppSettings {
  id String @id @default("default")

  /// The SMTP server the portal sends its own mail through. Separate from any
  /// domain's mail settings: those belong to a customer, this is yours.
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean @default(true)
  smtpUser     String?
  /// Encrypted at rest, never returned to the browser.
  smtpPassword String?
  fromAddress  String?
  fromName     String?

  /// Where alerts go. Comma separated, so more than one person can be told.
  notifyEmails String?

  // -------------------------------------------------------------------------
  // The mail server names customers are given.
  //
  // Set these once and every domain hands out the same pair, under your own
  // name rather than the provider's. Leaving them empty is a valid choice: it
  // means customers are told the provider's real hostnames, which is what
  // happened before any of this existed.
  //
  // These must point at something that actually answers on those ports with a
  // certificate valid for that name — usually a TLS proxy of your own in front
  // of the provider's mail servers. A name that resolves but presents somebody
  // else's certificate is worse than no name at all: the mail client shows a
  // warning with the real hostname printed in it.
  // -------------------------------------------------------------------------
  publicImapHost String?
  publicImapPort Int?
  publicSmtpHost String?
  publicSmtpPort Int?

  /// The master switch, and one per area so a noisy one can be silenced
  /// without losing the rest.
  notifyEnabled   Boolean @default(false)
  notifyDns       Boolean @default(true)
  notifyEmailMgmt Boolean @default(true)
  notifyFiles     Boolean @default(true)
  notifyDatabase  Boolean @default(true)
  notifyUsers     Boolean @default(true)
  notifySettings  Boolean @default(true)
  notifyOrders    Boolean @default(true)
  notifySecurity  Boolean @default(true)
  notifySupport   Boolean @default(true)
  notifyDeploy    Boolean @default(true)
  notifySchedule  Boolean @default(true)
  notifyBilling   Boolean @default(true)

  // -------------------------------------------------------------------------
  // Work that happens on its own, once a day.
  // -------------------------------------------------------------------------

  /// The master switch for everything scheduled. Off by default: a portal that
  /// starts contacting providers and customers the moment it boots would be a
  /// surprise, and surprises in this area cost trust.
  jobsEnabled Boolean @default(false)

  /// The hour jobs run at, 0-23, in the timezone below. Small hours by
  /// default — a full sync talks to a provider for a while, and a reminder is
  /// better read in the morning than at midnight.
  jobHour           Int @default(2)
  /// Minutes east of UTC. 330 is India, and the portal is written for India.
  /// Stored rather than read from the host so a container in UTC still runs
  /// these at the hour the operator meant.
  jobTimezoneOffset Int @default(330)

  /// Pull every provider's domains, mailboxes and DNS overnight.
  autoSyncEnabled Boolean @default(false)

  /// Tell somebody before a domain lapses.
  expiryRemindersEnabled Boolean @default(false)
  /// How many days ahead to warn, comma separated. One email per offset per
  /// expiry date, so renewing resets them.
  expiryReminderDays     String  @default("30,15,7,1")
  /// Whether the customer assigned to the domain is told as well, or only you.
  /// Off by default: telling a customer is a business decision, not a default.
  expiryRemindCustomer   Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Work that happens on its own.
//
// One row per job, holding both the lock and the history. A single row doing
// both jobs is deliberate: the thing that stops two workers running a sync at
// once is the same thing that answers "did it run last night, and did it
// work?", so the two can never disagree.
// ---------------------------------------------------------------------------

model ScheduledJob {
  /// The job's own name — "nightly-sync", "domain-expiry" — not a cuid. There
  /// is exactly one row per job and the name is how the code finds it.
  id String @id

  /// When it last finished, whether or not it succeeded. This is what makes
  /// "once a day" mean once a day across restarts: a container that is
  /// redeployed four times before lunch must not run the sync four times.
  lastRunAt      DateTime?
  lastOk         Boolean?
  lastMessage    String?
  lastDurationMs Int?

  /// Taken while the job runs and cleared afterwards. A stale lock — a process
  /// killed mid-run — is broken after an hour rather than blocking the job
  /// forever.
  runningSince DateTime?

  updatedAt DateTime @updatedAt

  @@map("scheduled_jobs")
}

/// A reminder that has already gone out, so it does not go out twice.
///
/// The unique key includes the expiry date, which is what makes renewals work
/// without any extra code: renewing moves `expiresAt`, so the key changes and
/// the whole ladder of reminders is due again for the new date.
model ExpiryReminder {
  id       String @id @default(cuid())
  domainId String

  /// Which rung of the ladder: 30, 15, 7, 1. Zero is the day itself.
  daysBefore Int
  /// The expiry this was about, to the day.
  expiresOn  DateTime @db.Date

  sentAt    DateTime @default(now())
  /// Whether the email actually went. Recorded for the same reason the
  /// activity log records it: "I never got a warning" needs an answer.
  delivered Boolean  @default(false)
  sentTo    String?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, daysBefore, expiresOn])
  @@index([domainId])
  @@map("expiry_reminders")
}

// ---------------------------------------------------------------------------
// Two-factor authentication
// ---------------------------------------------------------------------------

/// A single-use code for signing in when the authenticator app is gone.
///
/// Hashed, not stored: these are as good as the password, and a database dump
/// must not contain working ones. SHA-256 rather than bcrypt because they are
/// long random strings rather than chosen passwords — there is nothing to
/// brute-force — and sign-in has to try them one at a time.
model RecoveryCode {
  id     String @id @default(cuid())
  userId String

  codeHash String
  /// A hint the owner can recognise in a list, e.g. "3F2K". Never enough to
  /// use, and only ever shown to the account it belongs to.
  hint     String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// ---------------------------------------------------------------------------
// Quotations and invoices
//
// Money is in paise here for the same reason it is everywhere else, and tax is
// computed from whole-number rates rather than stored as a float. An invoice
// is a legal document: the arithmetic on it has to be exact, and it has to
// still say the same thing in three years.
// ---------------------------------------------------------------------------

enum DocumentKind {
  QUOTATION
  INVOICE
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  PAID
  CANCELLED
}

model BillingDocument {
  id String @id @default(cuid())

  kind   DocumentKind
  /// The number on the document: INV/2026-27/0001. Unique, sequential within
  /// its series, and never reused — a cancelled invoice keeps its number.
  number String       @unique
  /// The financial year it belongs to, "2026-27". April to March, because
  /// that is the year GST is filed against.
  series String

  status DocumentStatus @default(DRAFT)

  // The customer, copied rather than referenced. An address that changes next
  // year must not quietly rewrite a document that has already been issued.
  customerName      String
  customerEmail     String?
  customerPhone     String?
  customerAddress   String?
  customerGstin     String?
  /// Two digits. Together with the seller's, this decides CGST + SGST against
  /// IGST, which is the one thing a GST invoice cannot get wrong.
  customerStateCode String?

  /// Links back to whatever this is about, where there is something.
  userId   String?
  domainId String?
  orderId  String?

  issueDate  DateTime  @default(now())
  dueDate    DateTime?
  /// Quotations lapse; invoices do not.
  validUntil DateTime?

  /// Off is a real case, not an oversight: below the registration threshold a
  /// business issues a bill of supply with no tax on it at all.
  gstEnabled       Boolean @default(true)
  /// The seller's own details at the moment of issue, copied for the same
  /// reason the customer's are.
  sellerGstin      String?
  sellerStateCode  String?
  /// True when the two states differ, so one IGST line replaces CGST + SGST.
  isInterState     Boolean @default(false)
  /// Whether the prices as typed already have tax in them.
  pricesIncludeTax Boolean @default(false)

  subtotalMinor   Int @default(0)
  discountMinor   Int @default(0)
  taxableMinor    Int @default(0)
  cgstMinor       Int @default(0)
  sgstMinor       Int @default(0)
  igstMinor       Int @default(0)
  totalMinor      Int @default(0)
  amountPaidMinor Int @default(0)

  currency String @default("INR")

  notes String?
  terms String?

  /// When it was emailed, and when the money arrived. Both answer questions
  /// that otherwise depend on somebody's memory.
  sentOn           DateTime?
  paidOn           DateTime?
  paymentReference String?

  /// A quotation that became an invoice points at the invoice, and the
  /// invoice points back. Neither is a copy of the other: the quotation stays
  /// exactly as it was quoted.
  convertedToId   String? @unique
  convertedFromId String? @unique

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  BillingItem[]
  user   User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  domain Domain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  order  Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([kind, issueDate])
  @@index([status])
  @@map("billing_documents")
}

model BillingItem {
  id         String @id @default(cuid())
  documentId String

  description String
  /// HSN for goods, SAC for services — 998315 is web hosting. Typed rather
  /// than guessed: getting it wrong on a filed return is the customer's
  /// problem, so the portal does not invent one.
  hsnCode     String?

  /// Whole units. Hosting is sold by the year, not by the 1.5 year.
  quantity       Int
  unitPriceMinor Int
  /// Whole percent: 0, 5, 12, 18, 28. GST has no rate that needs a fraction
  /// for anything this portal sells.
  taxRatePct     Int @default(18)

  lineSubtotalMinor Int
  lineDiscountMinor Int @default(0)
  lineTaxableMinor  Int
  lineTaxMinor      Int
  lineTotalMinor    Int

  sortOrder Int @default(0)

  document BillingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("billing_items")
}

/// The next number in each series, so two documents created at the same moment
/// cannot take the same one. Incremented with an atomic UPDATE, which is the
/// only way to get this right under concurrency.
model DocumentCounter {
  id String @id @default(cuid())

  kind       DocumentKind
  series     String
  nextNumber Int          @default(1)

  @@unique([kind, series])
  @@map("document_counters")
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  AWAITING_CUSTOMER
  AWAITING_SUPPORT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id String @id @default(cuid())

  /// Short and sayable over the phone: TKT-7K3M9Q.
  reference String @unique
  subject   String

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)
  /// Billing, Technical, Email, Domain, Other. Free text with a suggested
  /// list rather than an enum, so a category can be added without a migration.
  category String?

  userId   String
  domainId String?

  /// Who spoke last, so the list can sort by what is waiting on you. Kept
  /// alongside `status` rather than derived from it: an admin can mark a
  /// ticket resolved without that changing who replied last.
  lastReplyAt     DateTime @default(now())
  lastReplyByRole Role     @default(USER)

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain   Domain?         @relation(fields: [domainId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([status, lastReplyAt])
  @@index([userId, lastReplyAt])
  @@map("tickets")
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String

  /// Null once the account is gone; the label keeps the thread readable.
  authorId    String?
  authorLabel String
  authorRole  Role

  body String

  /// A note for your own side of the desk. Never returned to the customer —
  /// enforced in the query, not by hiding it in the interface.
  isInternal Boolean @default(false)

  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ---------------------------------------------------------------------------
// Deploying a website
//
// The portal writes files onto the hosting account over FTP, FTPS or SFTP. It
// does not run anything it deploys — no build script, no install hook, not one
// line of the code. Running a customer's build here would run their code with
// this process's access to every provider token and FTP password it holds.
//
// Every deploy records enough to undo itself exactly: which files it created,
// and which it moved aside and to where. Rollback is then deleting the first
// list and moving the second one back, rather than a guess.
// ---------------------------------------------------------------------------

enum DeploySource {
  ZIP
  GIT
}

enum DeployStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

model Deployment {
  id       String @id @default(cuid())
  domainId String

  /// Per-domain and sequential, so it can be spoken about: "roll back
  /// deploy 7". Not a cuid, which nobody can read out loud.
  number Int

  source DeploySource
  status DeployStatus @default(RUNNING)

  /// Where it came from. Only one of these sets is filled in.
  gitUrl      String?
  gitRef      String?
  gitCommit   String?
  archiveName String?

  /// Relative to the domain's configured FTP root, so a deploy can target a
  /// subfolder without ever being able to address anything above the root.
  targetPath    String  @default("/")
  /// Whether files on the server that are not in the source are removed.
  /// Off is the safer default: deleting somebody's uploads folder because it
  /// was not in the zip is the worse mistake.
  deleteMissing Boolean @default(false)
  /// Paths never deleted even when deleteMissing is on, comma separated.
  keepPaths     String?

  filesCreated   Int @default(0)
  filesUpdated   Int @default(0)
  filesDeleted   Int @default(0)
  filesUnchanged Int @default(0)
  bytesUploaded  Int @default(0)

  /// Where the replaced files were moved to, beneath the domain's root.
  /// Null once the backup has been pruned, which is also what marks a deploy
  /// as no longer rollable back.
  backupPath   String?
  /// The files this deploy created, so rollback knows what to remove.
  createdPaths Json?
  /// The files it moved into the backup, so rollback knows what to restore.
  movedAside   Json?

  /// path -> sha256 of what was written. Lets the next deploy skip files that
  /// have not changed, which is what makes a second deploy of a large site
  /// finish in seconds. Null for a very large deploy, where the row would be
  /// bigger than the saving is worth.
  manifest Json?

  message String?
  error   String?

  actorId    String?
  actorLabel String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, number])
  @@index([domainId, startedAt])
  @@map("deployments")
}
