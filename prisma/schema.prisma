// Hosting Management Portal — database schema
// Kept deliberately small: one table per real concept, no speculative columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  USER
}

/// Where a record originally came from. Domains synced from a provider keep the
/// provider label; anything an admin types in by hand is MANUAL.
enum DomainSource {
  PROVIDER
  MANUAL
}

// ---------------------------------------------------------------------------
// Users & access
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  domains         UserDomain[]
  serverResource  ServerResource?
  queryLog        DatabaseQueryLog[]
  ordersPlaced    Order[]            @relation("OrderCustomer")
  ordersConfirmed Order[]            @relation("OrderConfirmedBy")
  activityLogs    ActivityLog[]

  @@map("users")
}

/// Join table: which domains a normal user is allowed to see and manage.
model UserDomain {
  id         String   @id @default(cuid())
  userId     String
  domainId   String
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, domainId])
  @@index([domainId])
  @@map("user_domains")
}

// ---------------------------------------------------------------------------
// Hosting providers
// ---------------------------------------------------------------------------

/// A configured hosting provider. `adapter` selects the server-side integration
/// (e.g. "hostinger"); adding a provider later means adding an adapter file.
model Provider {
  id        String   @id @default(cuid())
  name      String
  adapter   String
  docsUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Result of the most recent "Test Connection" click.
  lastTestedAt    DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  lastSyncedAt    DateTime?

  credential ProviderCredential?
  domains    Domain[]

  @@map("providers")
}

/// API token for a provider, encrypted at rest (AES-256-GCM) and never sent to
/// the browser — only `tokenHint` (last 4 characters) is ever exposed.
model ProviderCredential {
  id             String   @id @default(cuid())
  providerId     String   @unique
  encryptedToken String
  tokenHint      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_credentials")
}

// ---------------------------------------------------------------------------
// Domains
// ---------------------------------------------------------------------------

model Domain {
  id     String       @id @default(cuid())
  name   String       @unique
  source DomainSource @default(PROVIDER)

  // Null for manually added domains.
  providerId String?
  /// Provider's own identifier, used to match records on re-sync.
  externalId String?

  status       String    @default("unknown")
  type         String?
  expiresAt    DateTime?
  registeredAt DateTime?
  lastSyncedAt DateTime?

  /// What the site was last detected to be built on, and the evidence for it.
  /// Refreshed on every detection and never hand-edited, the same way mailbox
  /// figures are, so the real answer survives an administrator choosing to
  /// display something else.
  detectedTech         String?
  detectedTechVersion  String?
  /// "files" (read off the site's own filesystem) or "site" (read off the
  /// homepage). Which one it was changes how much the answer is worth.
  detectedTechSource   String?
  /// Why the detector concluded this, in words, e.g. "found wp-config.php".
  detectedTechEvidence String?
  /// "confirmed" or "likely".
  detectedTechLevel    String?
  detectedTechAt       DateTime?

  /// Administrator override. Null means "use what was detected", which is why
  /// it is nullable rather than defaulted — absent is meaningful here.
  techOverride        String?
  techVersionOverride String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider      Provider?          @relation(fields: [providerId], references: [id], onDelete: SetNull)
  dnsRecords    DnsRecord[]
  emailAccounts EmailAccount[]
  queryLog      DatabaseQueryLog[]
  orders        Order[]
  activity      ActivityLog[]
  settings      DomainSettings?
  assignments   UserDomain[]

  @@index([providerId])
  @@map("domains")
}

model DnsRecord {
  id       String @id @default(cuid())
  domainId String

  name    String
  type    String
  content String
  ttl     Int    @default(3600)

  /// True when the record came from the provider's DNS zone rather than being
  /// entered by hand. Provider records are replaced wholesale on each sync.
  isFromProvider Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@map("dns_records")
}

model EmailAccount {
  id       String @id @default(cuid())
  domainId String

  address String
  status  String  @default("unknown")
  notes   String?

  /// What the provider last reported. Refreshed on every sync and never
  /// hand-edited, so the real numbers are always available even when an
  /// administrator is choosing to display something else.
  providerQuotaMb Int?
  providerUsedMb  Int?

  /// Administrator overrides. Null means "use the provider's value", which is
  /// why these are nullable rather than defaulted — absent is meaningful here.
  quotaMbOverride Int?
  usedMbOverride  Int?

  /// Distinguishes mailboxes fetched from the provider from ones typed in.
  isFromProvider Boolean @default(false)
  externalId     String?

  /// The mailbox's own password, encrypted at rest (AES-256-GCM). Used to sign
  /// in to IMAP and SMTP on the owner's behalf; never sent to the browser.
  encryptedPassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, address])
  @@index([domainId])
  @@map("email_accounts")
}

/// Per-domain details the provider API does not expose (FTP/FTPS, server info,
/// notes). Everything here is optional and admin-maintained.
model DomainSettings {
  id       String @id @default(cuid())
  domainId String @unique

  // FTP / FTPS
  ftpHost     String?
  ftpPort     Int?
  ftpUsername String?
  ftpPassword String?
  ftpProtocol String? // FTP | FTPS | SFTP

  /// Directory the file manager is confined to, e.g. /public_html. Everything
  /// browsed through the portal is resolved beneath this.
  ftpRootPath String?

  // Mail servers, shared by every mailbox on the domain.
  imapHost   String?
  imapPort   Int?
  imapSecure Boolean @default(true)
  smtpHost   String?
  smtpPort   Int?
  smtpSecure Boolean @default(true)

  /// MySQL / MariaDB access. The provider API does not hand these out, so they
  /// are entered by hand, the same way FTP is. The password is encrypted at
  /// rest and never sent to the browser.
  dbHost     String?
  dbPort     Int?
  dbName     String?
  dbUser     String?
  dbPassword String?

  /// Whether statements that change data may run. Off means the query editor
  /// will only SELECT, which is the safe default for a database somebody's
  /// website depends on.
  dbAllowWrites Boolean @default(false)

  // Server information
  serverIp       String?
  serverHostname String?
  serverLocation String?
  nameservers    String?
  phpVersion     String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@map("domain_settings")
}

// ---------------------------------------------------------------------------
// Server resources (manually configured per user)
// ---------------------------------------------------------------------------

model ServerResource {
  id     String @id @default(cuid())
  userId String @unique

  cpuCores    Int?
  ramMb       Int?
  storageGb   Int?
  bandwidthGb Int?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("server_resources")
}

/// The express-session store, owned by connect-pg-simple at runtime.
///
/// It is declared here so the schema is the single source of truth and
/// migrations stop reporting drift; the application creates it via a
/// migration rather than at boot (see `createTableIfMissing: false`).
model UserSession {
  sid    String   @id(map: "session_pkey")
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}

/// A record of every statement that changed something, and who ran it.
///
/// A query box shared between people needs an audit trail: when a table looks
/// wrong a week later, this is the only thing that can say what went through
/// it. Reads are not logged — they are the ordinary case and would bury the
/// entries that matter.
model DatabaseQueryLog {
  id       String  @id @default(cuid())
  domainId String
  /// Null once the account that ran it has been deleted; the record of the
  /// statement outlives the person, which is rather the point.
  userId   String?

  /// Truncated to a sane length. This is a record, not a replay log.
  sql    String
  /// write | destructive | schema
  kind   String
  verb   String
  target String?

  createdAt DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([domainId, createdAt])
  @@map("database_query_log")
}

// ---------------------------------------------------------------------------
// The storefront: what is for sale, and what people have ordered.
//
// Money is stored in paise as whole integers. A price is never a float — a
// rounding error in a number somebody is asked to pay is not an acceptable
// class of bug, and 1499.99 cannot be held exactly in binary floating point.
// ---------------------------------------------------------------------------

enum PlanKind {
  HOSTING
  EMAIL
  OTHER
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

/// A hosting plan as it appears on the public site.
model Plan {
  id      String   @id @default(cuid())
  /// Used in the public URL, so it stays stable even when the name changes.
  slug    String   @unique
  name    String
  kind    PlanKind @default(HOSTING)
  tagline String?

  priceMinor    Int
  /// Shown struck through beside the price, for a plan that is discounted.
  wasPriceMinor Int?
  currency      String        @default("INR")
  billingPeriod BillingPeriod @default(YEARLY)

  /// One selling point per entry, in the order they should be read.
  features String[]

  /// Hidden plans stay orderable by reference but off the public list, so a
  /// plan can be retired without breaking the orders that already name it.
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

/// What one domain ending costs. A .com and a .in are genuinely different
/// prices, so this is a list rather than a single "domain" plan.
model TldPrice {
  id  String @id @default(cuid())
  /// Without the dot, lower case: "com", "co.in".
  tld String @unique

  registerMinor Int
  /// What it costs to keep, where that differs from the first year. Shown so
  /// nobody is surprised at renewal.
  renewMinor    Int?
  currency      String @default("INR")

  isActive  Boolean @default(true)
  isPopular Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("tld_prices")
}

enum OrderKind {
  HOSTING
  DOMAIN
}

enum OrderStatus {
  /// Placed, nothing paid yet.
  PENDING_PAYMENT
  /// The customer says they have paid and given a reference. Nobody has
  /// checked. This status exists precisely because UPI cannot confirm itself.
  PAYMENT_SUBMITTED
  /// An administrator has seen the money arrive.
  PAID
  /// Set up and handed over.
  PROVISIONED
  CANCELLED
}

model Order {
  id String @id @default(cuid())

  /// What the customer is given, and the only key the public lookup accepts.
  /// Random rather than sequential: it is effectively a bearer token, so it
  /// must not be guessable from another order's.
  reference String @unique

  kind       OrderKind
  planId     String?
  /// The ending ordered, for a domain order.
  tld        String?
  /// The domain being registered, or the one hosting is for.
  domainName String?

  customerName  String
  customerEmail String
  customerPhone String
  message       String?

  /// Worked out on the server from the plan or the TLD. What the browser
  /// thought the price was is never trusted.
  amountMinor   Int
  currency      String         @default("INR")
  billingPeriod BillingPeriod?

  status OrderStatus @default(PENDING_PAYMENT)

  /// What the customer typed after paying. Unverified by definition — a UPI
  /// reference cannot be checked from here, and anyone could invent one.
  paymentReference   String?
  paymentSubmittedAt DateTime?
  paidAt             DateTime?
  provisionedAt      DateTime?

  /// Who confirmed the payment, so a money decision has a name against it.
  confirmedById String?
  adminNotes    String?

  /// Filled in once the order has been turned into something real.
  domainId String?
  userId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan        Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  confirmedBy User?   @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  domain      Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  user        User?   @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("orders")
}

/// The one row of storefront configuration: who is selling, and how to pay.
model StoreSettings {
  /// A single row, addressed by a fixed id.
  id String @id @default("default")

  businessName String?
  headline     String?
  subheadline  String?
  supportEmail String?

  /// Where the money goes. Shown to customers, so it is deliberately not a
  /// secret — but it is the one field that decides who gets paid, so only a
  /// Super Admin can change it.
  upiId        String?
  upiPayeeName String?

  /// Digits with country code, no plus or spaces: 919876543210.
  whatsappNumber String?

  currency String  @default("INR")
  /// Closes the shop without deleting anything.
  isOpen   Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

// ---------------------------------------------------------------------------
// Knowing what happened.
//
// Every change worth an administrator's attention is written here first, and
// emailed second. That order matters: the record is the product, and the email
// is one way of reading it. An SMTP server that is down, misconfigured or
// simply slow must not cost you the history.
// ---------------------------------------------------------------------------

model ActivityLog {
  id String @id @default(cuid())

  /// A dotted name: "dns.record.deleted", "email.mailbox.created". Grouped by
  /// its first part so a whole area can be switched off at once.
  event String

  /// Who did it. Null for something the system did, or once the account has
  /// been deleted — the record of the act outlives the actor.
  actorId    String?
  /// Kept as text as well, so an entry still reads correctly after the account
  /// it names is gone.
  actorLabel String?
  actorRole  String?

  /// One line, already written for a person: "Deleted the MX record for @".
  summary String
  /// Anything worth having in the email but not in the headline.
  detail  String?

  /// What it happened to, where that makes sense.
  domainId   String?
  domainName String?

  /// Where the request came from, for the sign-in failures.
  ip String?

  /// Whether an email went out, and why not when it did not. Without this,
  /// "I never got an alert" is unanswerable.
  notified    Boolean @default(false)
  notifyError String?

  createdAt DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  domain Domain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([event, createdAt])
  @@map("activity_log")
}

/// Application settings: one row, for things that are not about a domain.
model AppSettings {
  id String @id @default("default")

  /// The SMTP server the portal sends its own mail through. Separate from any
  /// domain's mail settings: those belong to a customer, this is yours.
  smtpHost     String?
  smtpPort     Int?
  smtpSecure   Boolean @default(true)
  smtpUser     String?
  /// Encrypted at rest, never returned to the browser.
  smtpPassword String?
  fromAddress  String?
  fromName     String?

  /// Where alerts go. Comma separated, so more than one person can be told.
  notifyEmails String?

  /// The master switch, and one per area so a noisy one can be silenced
  /// without losing the rest.
  notifyEnabled   Boolean @default(false)
  notifyDns       Boolean @default(true)
  notifyEmailMgmt Boolean @default(true)
  notifyFiles     Boolean @default(true)
  notifyDatabase  Boolean @default(true)
  notifyUsers     Boolean @default(true)
  notifySettings  Boolean @default(true)
  notifyOrders    Boolean @default(true)
  notifySecurity  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
